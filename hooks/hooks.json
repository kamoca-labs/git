{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/commit-message-readable.ts\"",
            "timeout": 10,
            "statusMessage": "git:commit-message-readable: mensagem legível"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/semantic-title.ts\"",
            "timeout": 10,
            "statusMessage": "git:semantic-title: título semântico"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/title-length.ts\"",
            "timeout": 10,
            "statusMessage": "git:title-length: tamanho do título"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/single-item-commit.ts\"",
            "timeout": 10,
            "statusMessage": "git:single-item-commit: um assunto por commit"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/commit-body.ts\"",
            "timeout": 10,
            "statusMessage": "git:commit-body: body obrigatório"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/no-co-author.ts\"",
            "timeout": 10,
            "statusMessage": "git:no-co-author: sem co-author"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/protected-branch-commit.ts\"",
            "timeout": 10,
            "statusMessage": "git:protected-branch-commit: commit na main"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/protected-branch-push.ts\"",
            "timeout": 10,
            "statusMessage": "git:protected-branch-push: push na main"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*(github|gitlab).*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-no-ai.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-no-ai: PR/MR sem menção a IA"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-semantic-title.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-semantic-title: título semântico do PR/MR"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-title-length.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-title-length: tamanho do título do PR/MR"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-description.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-description: descrição obrigatória do PR/MR"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-sections.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-sections: seções da descrição do PR/MR"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/mr-no-squash.ts\"",
            "timeout": 10,
            "statusMessage": "git:mr-no-squash: sem squash"
          }
        ]
      },
      {
        "matcher": "mcp__.*(github|gitlab).*__(add_commit|create_commit|create_or_update_file|push_files|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/no-api-commit.ts\"",
            "timeout": 10,
            "statusMessage": "git:no-api-commit: commit só via git"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/main-audit.ts\"",
            "timeout": 10,
            "statusMessage": "git:main-audit: auditoria da main"
          }
        ]
      }
    ]
  }
}
